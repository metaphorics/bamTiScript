{
  "name": "bamti-cli",
  "version": "0.2.0",
  "description": "BamTS compiler command-line interface",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaphorics/bamTiScript.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "exports": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "prepublishOnly": "node --input-type=module -e \"import { accessSync } from 'node:fs'; accessSync('cli-release-table.json')\" && node ../scripts/preflight.mjs --registry-only"
  },
  "bin": {
    "bamts": "bin/bamts.js"
  },
  "files": [
    "README.md",
    "bin/bamts.js",
    "cli-release-table.json",
    "index.d.ts",
    "index.js"
  ],
  "optionalDependencies": {
    "@bamti/cli-darwin-arm64": "0.2.0",
    "@bamti/cli-darwin-x64": "0.2.0",
    "@bamti/cli-linux-arm64": "0.2.0",
    "@bamti/cli-linux-x64": "0.2.0",
    "@bamti/cli-win32-x64": "0.2.0"
  }
}
