{
  "name": "bamti",
  "version": "0.2.0",
  "description": "In-process Node.js interface for the BamTS TypeScript compiler",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/metaphorics/bamTiScript.git"
  },
  "engines": {
    "node": ">=24"
  },
  "type": "module",
  "main": "./index.js",
  "exports": "./index.js",
  "types": "./index.d.ts",
  "scripts": {
    "prepublishOnly": "node --input-type=module -e \"import { accessSync } from 'node:fs'; accessSync('native-release-table.json')\""
  },
  "files": [
    "README.md",
    "index.d.ts",
    "index.js",
    "native-loader.js",
    "native-release-table.json",
    "native-runner.js"
  ],
  "optionalDependencies": {
    "@bamti/bamti-linux-x64-gnu": "0.2.0",
    "@bamti/bamti-linux-arm64-gnu": "0.2.0",
    "@bamti/bamti-darwin-x64": "0.2.0",
    "@bamti/bamti-darwin-arm64": "0.2.0",
    "@bamti/bamti-win32-x64-msvc": "0.2.0"
  }
}
